 "voice": [
  {
   "id": "n01",
   "who": "Narrator",
   "text": "Eight German letters. One patient.",
   "dur": 2.098,
   "ok": false,
   "src": "audio/vo/n01.wav",
   "v": 2.098
  },
  {
   "id": "n02",
   "who": "Narrator",
   "text": "Two minutes to find what matters before surgery.",
   "dur": 2.587,
   "ok": false,
   "src": "audio/vo/n02.wav",
   "v": 2.587
  },
  {
   "id": "h01b",
   "who": "Hromadová (AI placeholder)",
   "text": "Blood thinners, allergies, heart function. I can see everything, and also where it came from, which is nice.",
   "dur": 7.428,
   "ok": false,
   "src": "audio/vo/h01b.wav",
   "v": 7.428
  },
  {
   "id": "a01",
   "who": "Narrator",
   "text": "Enter the patient, then the task.",
   "dur": 2.038,
   "ok": false,
   "src": "audio/vo/a01.wav",
   "v": 2.038
  },
  {
   "id": "a02",
   "who": "Narrator",
   "text": "Two seconds later: one screen.",
   "dur": 2.029,
   "ok": false,
   "src": "audio/vo/a02.wav",
   "v": 2.029
  },
  {
   "id": "a03",
   "who": "Narrator",
   "text": "Contradictions on the left. What the task needs, in the centre. The original letters, on the right.",
   "dur": 6.156,
   "ok": false,
   "src": "audio/vo/a03.wav",
   "v": 6.156
  },
  {
   "id": "a04",
   "who": "Narrator",
   "text": "Allergies, blood thinner, airway and heart function come first.",
   "dur": 3.529,
   "ok": false,
   "src": "audio/vo/a04.wav",
   "v": 3.529
  },
  {
   "id": "a05",
   "who": "Narrator",
   "text": "EF sixty percent. Where from? One click shows the exact sentence in the original letter.",
   "dur": 5.759,
   "ok": false,
   "src": "audio/vo/a05.wav",
   "v": 5.759
  },
  {
   "id": "a06",
   "who": "Narrator",
   "text": "The records disagree: left or right carotid? Both sources, side by side.",
   "dur": 5.434,
   "ok": false,
   "src": "audio/vo/a06.wav",
   "v": 5.434
  },
  {
   "id": "a07",
   "who": "Narrator",
   "text": "Missing information is explicit: previous anaesthesia, not documented.",
   "dur": 4.876,
   "ok": false,
   "src": "audio/vo/a07.wav",
   "v": 4.876
  },
  {
   "id": "a08",
   "who": "Narrator",
   "text": "Browse every letter by date, or every fact by type.",
   "dur": 3.186,
   "ok": false,
   "src": "audio/vo/a08.wav",
   "v": 3.186
  },
  {
   "id": "u01",
   "who": "Urban (AI placeholder)",
   "text": "I don't have to trust a summary. I read the original myself.",
   "dur": 5.605,
   "ok": false,
   "src": "audio/vo/u01.wav",
   "v": 5.605
  },
  {
   "id": "r01",
   "who": "Narrator",
   "text": "Change the role: the GP gets diabetes drugs, HbA1c, and a twelve-kilo weight loss, calculated.",
   "dur": 7.386,
   "ok": false,
   "src": "audio/vo/r01.wav",
   "v": 7.386
  },
  {
   "id": "w01",
   "who": "Narrator",
   "text": "This isn't a mock-up. It runs on a working backend: names are removed before any AI call, data is encrypted, and every quote is checked against its letter.",
   "dur": 10.681,
   "ok": false,
   "src": "audio/vo/w01.wav",
   "v": 10.681
  },
  {
   "id": "s01",
   "who": "Narrator",
   "text": "We tested the whole running system end to end: five challenge situations, fifteen of fifteen correct.",
   "dur": 6.635,
   "ok": false,
   "src": "audio/vo/s01.wav",
   "v": 6.635
  },
  {
   "id": "s02",
   "who": "Narrator",
   "text": "One AI call with the whole record: five. Simple rules: eight.",
   "dur": 3.947,
   "ok": false,
   "src": "audio/vo/s02.wav",
   "v": 3.947
  },
  {
   "id": "s03",
   "who": "Narrator",
   "text": "Every contradiction in the test cases, found. Every answer under two and a half seconds.",
   "dur": 5.102,
   "ok": false,
   "src": "audio/vo/s03.wav",
   "v": 5.102
  },
  {
   "id": "x01",
   "who": "Narrator",
   "text": "Not built yet: a FHIR connection to hospital records.",
   "dur": 3.378,
   "ok": false,
   "src": "audio/vo/x01.wav",
   "v": 3.378
  },
  {
   "id": "k01",
   "who": "Kolieska (AI placeholder)",
   "text": "Seeing only relevant info is useful. It just needs to be nicely ordered, so we don't get lost.",
   "dur": 5.558,
   "ok": false,
   "src": "audio/vo/k01.wav",
   "v": 5.558
  },
  {
   "id": "x02",
