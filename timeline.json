{
 "T": {
  "n01": {
   "s": 0.4,
   "e": 2.944,
   "d": 2.544,
   "text": "Eight German letters. One patient.",
   "who": "N",
   "keys": [
    "Eight",
    "One"
   ]
  },
  "n02": {
   "s": 3.194,
   "e": 6.942,
   "d": 3.748,
   "text": "Two minutes to find what matters before surgery. Meet TORU.",
   "who": "N",
   "keys": [
    "TORU"
   ]
  },
  "h01b": {
   "s": 7.3420000000000005,
   "e": 14.77,
   "d": 7.428,
   "text": "Blood thinners, allergies, heart function. I can see everything, and also where it came from, which is nice.",
   "who": "H",
   "keys": []
  },
  "a01": {
   "s": 15.32,
   "e": 18.174,
   "d": 2.854,
   "text": "In TORU, enter the patient, then the task.",
   "who": "N",
   "keys": [
    "patient",
    "task"
   ]
  },
  "a02": {
   "s": 22.374,
   "e": 24.418,
   "d": 2.044,
   "text": "Two seconds later: one screen.",
   "who": "N",
   "keys": [
    "Two seconds"
   ]
  },
  "a03": {
   "s": 24.817999999999998,
   "e": 30.49,
   "d": 5.672,
   "text": "Contradictions on the left. What the task needs, in the centre. The original letters, on the right.",
   "who": "N",
   "keys": [
    "Contradictions",
    "centre",
    "original letters"
   ]
  },
  "a04": {
   "s": 31.04,
   "e": 34.988,
   "d": 3.948,
   "text": "For example: allergies, blood thinner, airway and heart function come first.",
   "who": "N",
   "keys": [
    "first"
   ]
  },
  "a05": {
   "s": 35.438,
   "e": 40.777,
   "d": 5.339,
   "text": "EF sixty percent. Where from? One click shows the exact sentence in the original letter.",
   "who": "N",
   "keys": [
    "EF",
    "One click",
    "exact sentence"
   ]
  },
  "a06": {
   "s": 41.327,
   "e": 46.336,
   "d": 5.009,
   "text": "The records disagree: left or right carotid? Both sources, side by side.",
   "who": "N",
   "keys": [
    "disagree",
    "side by side"
   ]
  },
  "a07": {
   "s": 46.836,
   "e": 51.413,
   "d": 4.577,
   "text": "Missing information is explicit: previous anaesthesia, not documented.",
   "who": "N",
   "keys": [
    "not documented"
   ]
  },
  "a08": {
   "s": 51.763,
   "e": 54.899,
   "d": 3.136,
   "text": "Browse every letter by date, or every fact by type.",
   "who": "N",
   "keys": [
    "by date",
    "by type"
   ]
  },
  "u01": {
   "s": 55.749,
   "e": 61.354,
   "d": 5.605,
   "text": "I don't have to trust a summary. I read the original myself.",
   "who": "U",
   "keys": []
  },
  "r01": {
   "s": 61.754,
   "e": 66.578,
   "d": 4.824,
   "text": "Change the role: the GP gets diabetes drugs, HbA1c and a weight loss.",
   "who": "N",
   "keys": [
    "role",
    "GP",
    "calculated"
   ]
  },
  "w01": {
   "s": 67.078,
   "e": 73.884,
   "d": 6.806,
   "text": "TORU is not a mock-up. It has a working backend. Names removed before any AI call, data encrypted.",
   "who": "N",
   "keys": [
    "working backend",
    "encrypted",
    "checked"
   ]
  },
  "s01": {
   "s": 74.384,
   "e": 79.291,
   "d": 4.907,
   "text": "We tested TORU end to end on the running system: fifteen of fifteen correct.",
   "who": "N",
   "keys": [
    "fifteen of fifteen"
   ]
  },
  "s02": {
   "s": 79.691,
   "e": 84.236,
   "d": 4.545,
   "text": "One AI call with the whole record: six. Simple rules: eight.",
   "who": "N",
   "keys": [
    "six",
    "eight"
   ]
  },
  "s03": {
   "s": 84.686,
   "e": 90.94800000000001,
   "d": 6.262,
   "text": "Zero false alarms. Every fact traceable, none invented. Typical answer: under two seconds.",
   "who": "N",
   "keys": [
    "Zero",
    "none invented"
   ]
  },
  "s04": {
   "s": 91.44800000000001,
   "e": 96.531,
   "d": 5.083,
   "text": "Why an LLM? On unseen requests, it lifts complete checklists from half to two thirds.",
   "who": "N",
   "keys": [
    "half",
    "two thirds"
   ]
  },
  "x01": {
   "s": 97.131,
   "e": 103.962,
   "d": 6.831,
   "text": "Not working yet: thirteen percent of unusual requests still miss an item. And there is no FHIR link.",
   "who": "N",
   "keys": [
    "Not working yet"
   ]
  },
  "k01": {
   "s": 104.412,
   "e": 109.97,
   "d": 5.558,
   "text": "Seeing only relevant info is useful. It just needs to be nicely ordered, so we don't get lost.",
   "who": "K",
   "keys": []
  },
  "x02": {
   "s": 110.42,
   "e": 116.541,
   "d": 6.121,
   "text": "Doctors in Austria, Slovakia and Switzerland tried TORU, and want it. Next: a supervised pilot.",
   "who": "N",
   "keys": [
    "Austria",
    "Slovakia",
    "Switzerland",
    "Next"
   ]
  }
 },
